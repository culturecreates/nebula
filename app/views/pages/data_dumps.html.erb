<% content_for(:title) { t("data_dumps.title") } %>

<div class="container py-4">
  <h1 class="h3 mb-3"><%= t("data_dumps.title") %></h1>
  <p><%= t("data_dumps.description") %></p>

  <% if @data_dumps.present? %>
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th scope="col"><%= t("data_dumps.table.name") %></th>
            <th scope="col"><%= t("data_dumps.table.version") %></th>
            <th scope="col"><%= t("data_dumps.table.description") %></th>
            <th scope="col"><%= t("data_dumps.table.resource_uri") %></th>
            <th scope="col"><%= t("data_dumps.table.data_dump_uri") %></th>
            <th scope="col"><%= t("data_dumps.table.download_url") %></th>
          </tr>
        </thead>
        <tbody>
          <% @data_dumps.each do |dump| %>
            <tr>
              <% data_dump_url = safe_external_url(dump[:data_dump_uri]) %>
              <% download_url = safe_external_url(dump[:download_url]) %>
              <td><%= I18n.t("data_dumps.dumps.#{dump[:translation_key]}.title", default: dump[:title]) %></td>
              <td><%= dump[:version].presence || t("data_dumps.not_available") %></td>
              <td><%= I18n.t("data_dumps.dumps.#{dump[:translation_key]}.description", default: dump[:description].presence || t("data_dumps.not_available")) %></td>
              <td><code><%= dump[:resource_uri] %></code></td>
              <td>
                <% if data_dump_url.present? %>
                  <%= link_to dump[:data_dump_uri], data_dump_url, target: "_blank", rel: "noopener" %>
                <% else %>
                  <%= t("data_dumps.not_available") %>
                <% end %>
              </td>
              <td>
                <% if download_url.present? %>
                  <%= link_to dump[:download_url], download_url, target: "_blank", rel: "noopener" %>
                <% else %>
                  <%= t("data_dumps.not_available") %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-warning" role="alert">
      <%= t("data_dumps.unavailable") %>
    </div>
  <% end %>
</div>
