<% provide(:title, @entity.label&.value) %>
<% provide(:image, @entity.image) %>
<% provide(:uri, @entity.entity_uri) %>
<% provide(:body_class, "non-authoritative") unless is_authoritative(@entity.entity_uri.to_s) %>

<div class="container">
  <div class="d-flex justify-content-between align-items-start">
    <div>
      <h1 class="me-3">
        <%= @entity.label&.value&.html_safe %>
      </h1>
      <%= render partial: "entity/disambiguating_description", locals: { entity: @entity } %>
      <div class="d-flex flex-wrap align-items-center column-gap-3 mb-2">
        <%= render partial: "shared/clipboard", locals: { uri: @entity.entity_uri } %>
        <% if is_authoritative(@entity.entity_uri) %>
          <turbo-frame    id='date-modified'
                          class="d-flex align-items-center" style="min-height: 1.75rem;"
                          src="<%= entity_date_modified_path(uri: @entity.entity_uri) %>"
                          loading="lazy"
                          target="_top">
          </turbo-frame>
        <% end %>
      </div>
      <%= render partial: "entity_nav" %>
      <% if !is_authoritative(@entity.entity_uri) %>
        <%= t("entity.non_authoritative") %>
        <turbo-frame    id='source-graph-info'
                        src="<%= source_graph_show_path(uri: @entity.entity_uri) %>"
                        loading="lazy"
                        target="_top">
        </turbo-frame>
      <% end %>
    </div>
    <% if @entity.image.present? %>
      <a href="<%= @entity.image %>"><img
          src="<%= @entity.image %>"
          alt="<%= @entity.label&.value %>"
          class="img-fluid"
          style="max-height: 100px;"
        ></a>
    <% end %>

  </div>

  <% if @entity.graph.count == 0 %>
    <%= render partial: "external_resource", locals: { entity: @entity } %>
  <% else %>

    <%= render partial: "statements_table",
    locals: {
      triples: @entity.graph.query([RDF.URI(@entity.entity_uri), nil, nil]),
      graph: @entity.graph,
      graph_name_uri: (level_2_access? ? (@entity.graph_uri || "http://kg.artsdata.ca/core") : nil)
    } %>
    <br>
    <turbo-frame
      id='unsupported-claims'
      src="<%= entity_unsupported_claims_path(uri: @entity.entity_uri) %>"
      loading="lazy"
      target="_top"
    > 
    </turbo-frame> 
    <br>
    <turbo-frame
      id='authorized-external-identifiers'
      src="<%= entity_authorized_external_identifiers_path(uri: @entity.entity_uri) %>"
      loading="lazy"
      target="_top"
    >
    </turbo-frame>
    <br>
    <turbo-frame
      id='reverse-statements'
      src="<%= entity_derived_statements_path(uri: @entity.entity_uri)%>"
      loading="lazy"
      target="_top"
    >
    </turbo-frame>

  <% end %>

</div>
<br>
<br>
