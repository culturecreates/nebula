<div
  class="dropdown d-inline-block"
  data-controller="refresh-entity"
  data-refresh-entity-uri-value="<%= entity.entity_uri %>"
  data-refresh-entity-preview-title-value="<%= t("entity.refresh.preview_title") %>"
  data-refresh-entity-calculating-value="<%= t("entity.refresh.calculating") %>"
  data-refresh-entity-nothing-to-update-value="<%= t("entity.refresh.nothing_to_update") %>"
  data-refresh-entity-error-value="<%= t("entity.refresh.error") %>"
>
  <a
    class="dropdown-toggle text-decoration-none me-2"
    href="#"
    role="button"
    id="refreshDropdownLink"
    data-bs-toggle="dropdown"
    aria-expanded="false"
    rel="nofollow"
  >
    <%= t("entity.refresh.title") %>
  </a>
  <ul class="dropdown-menu" aria-labelledby="refreshDropdownLink">
    <li>
      <a
        href="#"
        class="dropdown-item"
        rel="nofollow"
        data-action="click->refresh-entity#refresh"
      >
        <%= t("entity.refresh.all") %>
      </a>
    </li>
    <% sources = authorized_external_identifier_sources(entity) %>
    <% if sources.any? %>
      <li><hr class="dropdown-divider"></li>
      <% sources.each do |source| %>
        <li>
          <a
            href="#"
            class="dropdown-item"
            rel="nofollow"
            data-action="click->refresh-entity#refresh"
            data-refresh-entity-source-param="<%= source %>"
          >
            <%= use_prefix(source) %>
          </a>
        </li>
      <% end %>
    <% end %>
  </ul>
</div>
