<h1>Authorized External Identifiers for
  <%= @entity.label&.value %>
</h1>
<a><%= use_prefix(@entity.entity_uri) %></a>

<turbo-frame id="authorized-external-identifiers">
  <% if @entity.graph.count > 0 %>
    <h4>Authorized External Identifiers
    </h4>
    <p> Identifiers listed here will refresh claims in Artsdata authoritative entities when external data changes. Delete an external identifier sameAs to unauthorize it.</p>
    <%= render partial: "statements_table",
    locals: {
      triples: @entity.graph.query([RDF.URI(@entity.entity_uri), nil, nil]),
      graph: @entity.graph,
      graph_name_uri: "http://kg.artsdata.ca/core",
      triple_inverted: true
    } %>
  <% end %>
</turbo-frame>

<br>
<br>
<pre>
  <code>
    <% if  @entity.graph.count > 0 %>
      <%= @entity.graph.dump(:jsonld) %>
    <% end %>
  </code>
</pre>