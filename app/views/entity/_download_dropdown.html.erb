<div class="dropdown">
  <a
    class="dropdown-toggle text-decoration-none me-2"
    href="#"
    role="button"
    id="dropdownMenuLink"
    data-bs-toggle="dropdown"
    aria-expanded="false"
  >
    <%= t("entity.download.title") %>
  </a>
  <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
    <li><%= link_to t("entity.download.menu_jsonld_schema_org"),
      entity_path(
        uri: entity.entity_uri,
        format: :jsonld,
        frameTemplate: "schema_org",
      ),
      class: "dropdown-item",
      data: {
        turbo_prefetch: false,
      } %></li>
    <li><%= link_to t("entity.download.menu_jsonld_1_0"),
      entity_path(uri: entity.entity_uri, format: :jsonld),
      class: "dropdown-item",
      data: {
        turbo_prefetch: false,
      } %></li>
    <li><%= link_to t("entity.download.menu_jsonld_1_2_annotations"),
      entity_path(uri: entity.entity_uri, format: :jsonlds),
      class: "dropdown-item",
      data: {
        turbo_prefetch: false,
      } %></li>
    <li><%= link_to t("entity.download.menu_turtle"),
      entity_path(uri: entity.entity_uri, format: :ttl),
      class: "dropdown-item",
      data: {
        turbo_prefetch: false,
      } %>
    </li>
  </ul>
</div>
