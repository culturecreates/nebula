<% external_entity = !@entity.entity_uri.starts_with?("http://kg.artsdata.ca/") %>
<%#
  Links by visitor. Dereference requires a login, and hiding the links also keeps crawlers off them.

  External URI (not kg.artsdata.ca):
    Not signed in: no links.
    Signed in:     Dereference | Visit | [CMS v3 | CMS v4 if cms_links access] | Reconcile (mint) | GraphDB | [Delete if delete_entity access]

  Artsdata entity (kg.artsdata.ca):
    Not signed in: Download only (no trailing bar).
    Signed in:     Download | [Refresh if refresh_entity access] | [Merge if merge_entity access] | GraphDB | [Delete if delete_entity access]
%>
<div class="alternate-name d-flex align-items-center mt-1">
  <% if external_entity %>
    <% if user_signed_in? %>
      <%= link_to t("entity.nav.dereference"),
      dereference_external_path(uri: @entity.entity_uri),
      class: "text-decoration-none me-2",
      rel: "nofollow" %>
      |
      <a
        href="<%= @entity.entity_uri %>"
        class="text-decoration-none ms-2 me-2"
        rel="nofollow"
      >
        <%= t("entity.nav.visit") %>
      </a>
      |
      <% if user_has_access?("cms_links") %>
        <%= link_to t("entity.nav.cms_v3"), footlight_export_path(uri: @entity.entity_uri, version: "v3") %>
        |
        <%= link_to t("entity.nav.cms_v4"), footlight_export_path(uri: @entity.entity_uri, version: "v4") %>
        |
      <% end %>
      <%= link_to t("entity.nav.minter"),
      mint_preview_path(externalUri: @entity.entity_uri, label: @entity.label&.value),
      class: "ms-2 me-2",
      rel: "nofollow" %>
      |
    <% end %>
    
  <% else %>
    <%= render partial: "entity/download_dropdown", locals: { entity: @entity } %>
    <%# The bar separates Download from what follows; anonymous users only get Download. %>
    <% if user_signed_in? %>
      |
    <% end %>
    <% if user_has_access?("refresh_entity") %>
      <%= render partial: "entity/refresh_dropdown", locals: { entity: @entity } %>
      |
    <% end %>
    <% if user_has_access?("merge_entity") %>
      <%= render partial: "entity/merge_button", locals: { entity: @entity } %>
      |
    <% end %>

  <% end %>
  <% if user_signed_in? %>
    <a
      href="<%= graphdb_link(@entity.entity_uri) %>"
      class="text-decoration-none ms-2 me-2"
      rel="nofollow"
      id="graphdb"
    ><%= t("entity.nav.graphdb") %></a>
    <% if user_has_access?("delete_entity") %>
      |
      <%= form_with url: destroy_entity_path, method: :delete, local: true, html: { data: { controller: "confirm", action: "submit->confirm#confirm", confirm: t("entity.nav.delete_confirm") } } do |form| %>
        <%= form.hidden_field :uri, value: @entity.entity_uri %>
        <%= form.submit t("entity.nav.delete"),
                    class: "btn mt-0 ps-2 pe-2 p-0 alternate-name text-decoration-none",
                    data: {
                      disable_with: t("entity.nav.deleting"),
                    } %>
      <% end %>
    <% end %>
  <% end %>
 
</div>
<%# Refresh modal %>
<div class="modal fade" id="dryrunModal" tabindex="-1" aria-labelledby="dryrunModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="dryrunModalLabel"><%= t("entity.refresh.preview_title") %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("entity.refresh.close") %>"></button>
      </div>
      <div class="modal-body" id="dryrunModalBody">
        <!-- Dryrun response will be inserted here -->
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t("entity.refresh.cancel") %></button>
        <button type="button" class="btn btn-primary" id="dryrunModalOk"><%= t("entity.refresh.update") %></button>
      </div>
    </div>
  </div>

</div>
