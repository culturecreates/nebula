PREFIX schema: <http://schema.org/>
PREFIX prov: <http://www.w3.org/ns/prov#>
select ?event (sample(?name_lang) as ?name) ?mintDate  ?sourceEvent where {
    ?mint schema:about ?event ;
       prov:generatedAtTime ?mintDate .
    ?event a schema:Event ;
       schema:name ?name_lang .
       OPTIONAL {
            << ?event schema:name ?name_lang >> prov:wasDerivedFrom|prov:hadPrimarySource ?sourceEvent .
       }
   }
group by ?event ?mintDate ?sourceEvent
order by desc(?mintDate)
limit 500
